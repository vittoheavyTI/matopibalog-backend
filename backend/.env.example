# Supabase
SUPABASE_URL=https://rjahjogidyndphdxevom.supabase.co
SUPABASE_SERVICE_KEY=cole_aqui_sua_service_role_key
# Chave anônima (anon/public) — usada para reenviar o e-mail de confirmação de
# cadastro (Auth resend type:signup). Sem ela, o reenvio é pulado (não-fatal).
SUPABASE_ANON_KEY=cole_aqui_sua_anon_public_key

# JWT
JWT_SECRET=troque_por_um_segredo_forte_em_producao

# Servidor
PORT=3000

# Frontend
FRONTEND_URL=https://matopibalog.com.br

# SMTP (opcional — para recuperação de senha)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Asaas (opcional — para pagamentos)
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
# Token de autenticação do webhook (mesmo valor configurado no painel do Asaas).
# Sem esta var, o webhook rejeita tudo com 401 (fail-closed).
ASAAS_WEBHOOK_TOKEN=

# Clicksign (opcional — para contratos digitais)
CLICKSIGN_TOKEN=

# Setup do administrador (usado só pelo script setup_admin.js)
# ADMIN_PASSWORD é obrigatório ao rodar o script; sem ele o script aborta.
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=defina_uma_senha_forte_localmente
