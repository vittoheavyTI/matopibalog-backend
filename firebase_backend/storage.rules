rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    
    match /comprovantes/{motoristaUid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == motoristaUid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == motoristaUid;
    }
  }
}
